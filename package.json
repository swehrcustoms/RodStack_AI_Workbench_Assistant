{
  "name": "rodstack-ai-workbench-assistant",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/stripeSync.test.ts tests/askClaude.test.ts tests/rls-migration.test.ts tests/edge-functions.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:staging": "PLAYWRIGHT_STAGING=1 playwright test --config=playwright.staging.config.ts",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run build",
    "validate:full": "npm run validate && npm run test:e2e",
    "admin:promote-owner": "node scripts/promote-owner.mjs",
    "stripe:reconcile": "node scripts/stripe-reconcile.mjs",
    "deploy:staging": "bash scripts/deploy-staging.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "idb": "^8.0.2",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "recharts": "^2.15.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.3",
    "vitest": "^3.0.5"
  }
}
