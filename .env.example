# Client-safe public config only. Never put secrets in VITE_* variables.
# Copy to .env.local for local development:
#   cp .env.example .env.local

# Optional: Supabase Auth + workspace sync (anon key is public; protect data with RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Forms webhook (Apps Script / Edge Function). Prefer authenticated endpoints.
VITE_FORMS_WEBHOOK_URL=

# DO NOT SET (removed — insecure in the browser bundle):
# VITE_ADMIN_PASSWORD=
# VITE_ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY=   # server-only, via proxy — never VITE_
