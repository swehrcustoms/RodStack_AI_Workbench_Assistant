# Client-safe public config only. Never put secrets in VITE_* variables.
# Copy to .env.local for local development:
#   cp .env.example .env.local

# Required for production auth + owner console (anon key is public; protect data with RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Forms webhook (Apps Script / Edge Function). Prefer authenticated endpoints.
VITE_FORMS_WEBHOOK_URL=

# Server-only (Supabase Edge Functions / Dashboard secrets — NEVER VITE_):
# SUPABASE_SERVICE_ROLE_KEY=
# ANTHROPIC_API_KEY=

# DO NOT SET:
# VITE_ADMIN_PASSWORD=
# VITE_ANTHROPIC_API_KEY=
