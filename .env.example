# Client-safe public config only. Never put secrets in VITE_* variables.
# Copy to .env.local for local development:
#   cp .env.example .env.local

# Required for production/staging SPA (anon key is public; protect data with RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional publishable Stripe key for future Checkout UI (never the secret key)
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional: Forms webhook (Apps Script / Edge Function). Prefer authenticated endpoints.
VITE_FORMS_WEBHOOK_URL=

# ─── Server-only (shell scripts / local CLI — NEVER VITE_) ────────────────────
# SUPABASE_URL=                 # usually same as VITE_SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY=    # npm run admin:promote-owner / stripe:reconcile
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_ENTERPRISE=

# ─── Supabase Edge Function secrets (supabase secrets set) ────────────────────
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_ENTERPRISE=

# ─── Staging E2E only ─────────────────────────────────────────────────────────
# PLAYWRIGHT_BASE_URL=https://your-staging.vercel.app
# E2E_PLATFORM_OWNER_EMAIL=
# E2E_PLATFORM_OWNER_PASSWORD=
# E2E_STANDARD_USER_EMAIL=
# E2E_STANDARD_USER_PASSWORD=

# DO NOT SET:
# VITE_ADMIN_PASSWORD=
# VITE_ANTHROPIC_API_KEY=
# VITE_SUPABASE_SERVICE_ROLE_KEY=
# VITE_STRIPE_SECRET_KEY=
# VITE_STRIPE_WEBHOOK_SECRET=
# VITE_SUPABASE_SERVICE_ROLE_KEY=
